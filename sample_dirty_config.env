# Intentionally unsafe sample config for testing text-file scanning.
# Contains a mix of things that SHOULD be flagged and things that should NOT.

APP_NAME=data-ethics-tool
DEBUG=true

# Should be flagged: secret-looking key with a real-looking value.
API_KEY=sk_live_51H8xyzABCDEF9876543210
DB_PASSWORD=hunter2hunter2

# Should be flagged: recognizable secret format, regardless of key name.
AWS_KEY_NOTE=AKIAABCDEFGHIJKLMNOP

# Should NOT be flagged: obvious placeholders.
STRIPE_SECRET=changeme
ADMIN_PASSWORD=<your_password_here>
LEGACY_TOKEN=
